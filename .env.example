# Social Media API Keys - KEEP THIS SECURE!
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to git (add to .gitignore)

# ===== TWITTER/X API =====
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here

# ===== BLUESKY API =====
# Get from: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=abstractemporiumart.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here

# ===== MASTODON API =====
# Get from: https://mastodon.social/settings/applications
MASTODON_ACCESS_TOKEN=your_access_token_here

# ===== FACEBOOK API =====
# Get from: https://developers.facebook.com/apps
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_ACCESS_TOKEN=your_access_token_here

# ===== PINTEREST API (OPTIONAL) =====
# Get from: https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=your_access_token_here
PINTEREST_BOARD_ID=your_board_id_here

# ===== BREVO (Email) API (OPTIONAL) =====
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_api_key_here
